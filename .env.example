# Copy to .env and fill in. .env is not committed.

# Telegram: token from @BotFather, chat id of the user/group/channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# session.mode=static: value of localStorage["privy:token"] from fomo.family
# (quotes are fine). Alternatively paste it into token.txt.
FOMO_ACCESS_TOKEN=

# session.mode=chromedp (optional)
FOMO_CHROME_PATH=
FOMO_CHROME_NO_SANDBOX=

# Theses pages and /health/accounts on a server (empty = this computer only).
# FOMO_ADMIN_TOKEN: any long random string, required with FOMO_PUBLIC_URL.
FOMO_PUBLIC_URL=
FOMO_ADMIN_TOKEN=

# Axiom (source of new tokens). Optional if you logged in with
# `fomobot -axiom-login`. Cookies of axiom.trade from DevTools → Application → Cookies.
AXIOM_ACCESS_TOKEN=
AXIOM_REFRESH_TOKEN=
CF_CLEARANCE=

# -record mode: PostgreSQL connection string
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/fomo
